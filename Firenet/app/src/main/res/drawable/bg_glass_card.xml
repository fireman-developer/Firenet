<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card: a faint top-to-bottom sheen over a translucent fill with a light border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#0DFFFFFF"
        android:endColor="#26FFFFFF"
        android:type="linear" />

    <corners android:radius="24dp" />

    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
